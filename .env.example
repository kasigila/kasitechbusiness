# KasiTech Business — environment variable names only (no secrets)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=https://kasitechinnovations.com

# Set true to browse workspace/command shells without Supabase (dev/preview only)
NEXT_PUBLIC_PREVIEW_UI=true

# Supabase (browser-safe anon key only for NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Optional: allow preview UI even when NODE_ENV=production (staging demos only)
# ALLOW_PREVIEW_UI=true

# Optional observability
SENTRY_DSN=

# Email (invitations, password reset hooks)
RESEND_API_KEY=
EMAIL_FROM=KasiTech Business <noreply@kasitechinnovations.com>

# Payments (aggregator — M-Pesa / card). Leave empty to use manual recording.
PAYMENT_DEFAULT_PROVIDER=manual
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
