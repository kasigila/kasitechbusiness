# KasiTech Business — environment variable names only (no secrets)

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=https://kasitechinnovations.com

# Supabase (browser-safe anon key only for NEXT_PUBLIC_*)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — never expose to the client
SUPABASE_SERVICE_ROLE_KEY=

# Optional observability
SENTRY_DSN=

# Email (invitations, password reset hooks)
RESEND_API_KEY=
EMAIL_FROM=KasiTech Business <noreply@kasitechinnovations.com>
